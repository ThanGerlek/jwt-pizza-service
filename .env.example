# Required in production (see src/config.js)
# JWT_SECRET=
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# FACTORY_URL=
# FACTORY_API_KEY=
# METRICS_ENDPOINT_URL=
# METRICS_ACCOUNT_ID=
# METRICS_API_KEY=
# LOGGING_ENDPOINT_URL=
# LOGGING_ACCOUNT_ID=
# LOGGING_API_KEY=

# Optional CORS: comma-separated exact origins. When unset, dev-style defaults allow any origin (see service.js).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth brute-force mitigation (requests per window; see express-rate-limit defaults in service.js)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=100

# Optional: extra hostnames allowed for factory report URLs (comma-separated). Factory host is always allowed.
# FACTORY_REPORT_HOST_ALLOWLIST=

# First-time DB only: create an admin user (password min 8 chars)
# SEED_DEFAULT_ADMIN=true
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# CLI admin creation (init.js) — prefer over argv password
# INIT_ADMIN_PASSWORD=

# Behind a reverse proxy, for correct rate-limit client IP
# TRUST_PROXY=1

# Error responses: set to true to include stack traces (never in real production)
# EXPOSE_ERROR_DETAILS=
