{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,

    // "allowSyntheticDefaultImports": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true

  },
  "include": ["src"]
}
